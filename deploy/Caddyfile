{$APP_DOMAIN} {
    encode gzip zstd

    log ws_access {
        no_hostname
        output stdout
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
    }

    redir /meet /meet/ 308

    @jitsi_config {
        path /meet/config.js /meet/interface_config.js
    }
    header @jitsi_config {
        Cache-Control "no-store, no-cache, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    @jitsi_html path_regexp jitsi_html ^/meet(?:/[^./?]+)?/?$
    header @jitsi_html {
        Cache-Control "no-store, no-cache, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    handle_path /meet/* {
        reverse_proxy jitsi-web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @jitsi_transport {
        path /http-bind /xmpp-websocket /colibri-ws/* /colibri-relay-ws/*
    }
    handle @jitsi_transport {
        reverse_proxy jitsi-web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @blocked_actuator path /actuator/*
    handle @blocked_actuator {
        respond "Not found" 404
    }

    @blocked_dotenv path_regexp blocked_dotenv (?i)^/(?:.*?/)?\.env(?:$|[./~_:-].*)
    handle @blocked_dotenv {
        respond "Not found" 404
    }

    @blocked_git path_regexp blocked_git (?i)^/(?:.*?/)?\.git(?:$|/.*)
    handle @blocked_git {
        respond "Not found" 404
    }

    @blocked_phpinfo_path path_regexp blocked_phpinfo_path (?i)^/(?:.*?/)?(?:phpinfo(?:$|/.*|\.php(?:\.old)?(?:$|/.*)?)|[^/]*phpinfo[^/]*\.php(?:\.old)?(?:$|/.*)?)
    handle @blocked_phpinfo_path {
        respond "Not found" 404
    }

    @blocked_phpinfo_query query phpinfo=*
    handle @blocked_phpinfo_query {
        respond "Not found" 404
    }

    @backend_websocket {
        path /ws /ws/*
    }
    handle @backend_websocket {
        log_name ws_access
        reverse_proxy backend:8080 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @backend_api path /api/*
    handle @backend_api {
        reverse_proxy backend:8080 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @backend_docs {
        path /v3/api-docs /v3/api-docs/* /v3/api-docs.yaml /swagger-ui /swagger-ui/* /swagger-ui.html
    }
    handle @backend_docs {
        reverse_proxy backend:8080 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    handle_path /storage/* {
        reverse_proxy minio:9000 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @observability_disabled {
        path /observability /observability/*
    }
    handle @observability_disabled {
        respond "Not found" 404
    }

    handle {
        reverse_proxy web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }
}
