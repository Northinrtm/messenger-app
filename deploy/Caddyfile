{$APP_DOMAIN} {
    encode gzip zstd

    redir /meet /meet/ 308
    redir /observability /observability/ 308

    @jitsi_config {
        path /meet/config.js /meet/interface_config.js
    }
    header @jitsi_config {
        Cache-Control "no-store, no-cache, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    @jitsi_html path_regexp jitsi_html ^/meet(?:/[^./?]+)?/?$
    header @jitsi_html {
        Cache-Control "no-store, no-cache, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    handle_path /meet/* {
        reverse_proxy jitsi-web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @jitsi_transport {
        path /http-bind /xmpp-websocket /colibri-ws/* /colibri-relay-ws/*
    }
    handle @jitsi_transport {
        reverse_proxy jitsi-web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @blocked_actuator path /actuator/*
    handle @blocked_actuator {
        respond "Not found" 404
    }

    handle /observability/* {
        reverse_proxy grafana:3000 {
            header_up X-Forwarded-Prefix /observability
            transport http {
                dial_timeout 5s
            }
        }
    }

    handle {
        reverse_proxy web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }
}
