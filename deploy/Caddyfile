{$APP_DOMAIN} {
    encode gzip zstd
    reverse_proxy web:80 {
        health_uri /healthz
        health_interval 30s
        health_timeout 5s
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
            read_timeout 30s
            write_timeout 30s
        }
    }
}

https://{$APP_DOMAIN}:8443 {
    encode gzip zstd
    reverse_proxy jitsi-web:80 {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
            read_timeout 30s
            write_timeout 30s
        }
    }
}
