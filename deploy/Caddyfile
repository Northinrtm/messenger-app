{$APP_DOMAIN} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
    }

    redir /meet /meet/ 308

    @jitsi_config {
        path /meet/config.js /meet/interface_config.js
    }
    header @jitsi_config {
        Cache-Control "no-store, no-cache, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    @jitsi_html path_regexp jitsi_html ^/meet(?:/[^./?]+)?/?$
    header @jitsi_html {
        Cache-Control "no-store, no-cache, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    handle_path /meet/* {
        reverse_proxy jitsi-web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @jitsi_transport {
        path /http-bind /xmpp-websocket /colibri-ws/* /colibri-relay-ws/*
    }
    handle @jitsi_transport {
        reverse_proxy jitsi-web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @blocked_actuator path /actuator/*
    handle @blocked_actuator {
        respond "Not found" 404
    }

    @backend_app {
        path /api/* /ws /ws/*
    }
    handle @backend_app {
        reverse_proxy backend:8080 {
            transport http {
                dial_timeout 5s
            }
        }
    }

    @observability_disabled {
        path /observability /observability/*
    }
    handle @observability_disabled {
        respond "Not found" 404
    }

    handle {
        reverse_proxy web:80 {
            transport http {
                dial_timeout 5s
            }
        }
    }
}
