POSTGRES_PASSWORD=CHANGE_ME
DB_URL=jdbc:postgresql://postgres:5432/messenger
DB_USERNAME=messenger
DB_PASSWORD=CHANGE_ME
APP_DB_MIN_IDLE=1
APP_DB_MAX_POOL_SIZE=4
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=15 -XX:MaxRAMPercentage=42 -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=32m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
APP_REALTIME_REDIS_ENABLED=true
MANAGEMENT_TRACING_ENABLED=false
APP_DOMAIN=your-domain.example
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example
APP_JWT_SECRET=REPLACE_WITH_A_BASE64_32_BYTE_SECRET
APP_JWT_REFRESH_TOKEN_TTL=P30D
APP_AUTH_REFRESH_COOKIE_SECURE=true
APP_AUTH_REGISTRATION_ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,msn.com,yahoo.com,yahoo.co.uk,yahoo.co.jp,icloud.com,me.com,mac.com,yandex.ru,yandex.com,ya.ru,mail.ru,bk.ru,inbox.ru,list.ru,rambler.ru,lenta.ru,myrambler.ru,autorambler.ru,proton.me,protonmail.com,pm.me,aol.com,gmx.com,gmx.de,gmx.net,fastmail.com,zoho.com
APP_AUTH_EMAIL_VERIFICATION_ENABLED=true
APP_AUTH_EMAIL_VERIFICATION_TOKEN_TTL=PT24H
APP_AUTH_EMAIL_VERIFICATION_URL_BASE=https://your-domain.example/
APP_AUTH_EMAIL_VERIFICATION_FROM_ADDRESS=no-reply@your-domain.example
APP_AUTH_PASSWORD_RESET_ENABLED=true
APP_AUTH_PASSWORD_RESET_TOKEN_TTL=PT30M
APP_AUTH_PASSWORD_RESET_URL_BASE=https://your-domain.example/
APP_AUTH_PASSWORD_RESET_FROM_ADDRESS=no-reply@your-domain.example
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=no-reply@your-domain.example
SPRING_MAIL_PASSWORD=CHANGE_ME
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_SSL_ENABLE=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
APP_ACTUATOR_SCRAPE_USERNAME=prometheus
APP_ACTUATOR_SCRAPE_PASSWORD=CHANGE_ME
MANAGEMENT_HEALTH_MAIL_ENABLED=false
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.05
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
ENABLE_OBSERVABILITY_STACK=false
ALERTMANAGER_WEBHOOK_URL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
JITSI_PUBLIC_URL=https://your-domain.example/meet
JITSI_ADVERTISE_IPS=YOUR_PUBLIC_IP
JITSI_JICOFO_COMPONENT_SECRET=CHANGE_ME
JITSI_JICOFO_AUTH_PASSWORD=CHANGE_ME
JITSI_JVB_AUTH_PASSWORD=CHANGE_ME
JITSI_JIBRI_RECORDER_PASSWORD=CHANGE_ME
JITSI_JIBRI_XMPP_PASSWORD=CHANGE_ME
