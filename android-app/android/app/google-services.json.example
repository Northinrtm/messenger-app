{
  "_comment": "Скопируй этот файл как google-services.json и заполни значениями из Firebase Console.",
  "_steps": [
    "1. Создай проект в https://console.firebase.google.com",
    "2. Добавь Android-приложение с package name: com.north.messenger.android",
    "3. Скачай google-services.json и положи рядом с этим файлом",
    "4. В Firebase Console -> Project Settings -> Service accounts -> Generate new private key",
    "5. Сохрани JSON сервис-аккаунта в APP_PUSH_FCM_SERVICE_ACCOUNT_JSON на сервере"
  ],
  "project_info": {
    "project_number": "REPLACE_WITH_PROJECT_NUMBER",
    "project_id": "REPLACE_WITH_PROJECT_ID",
    "storage_bucket": "REPLACE_WITH_PROJECT_ID.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "REPLACE_WITH_MOBILESDK_APP_ID",
        "android_client_info": {
          "package_name": "com.north.messenger.android"
        }
      },
      "api_key": [
        {
          "current_key": "REPLACE_WITH_API_KEY"
        }
      ],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": []
        }
      }
    }
  ],
  "configuration_version": "1"
}
